# Application
APP_NAME="AI Agent Builder"
APP_ENV="development"
DEBUG=false
HOST="127.0.0.1"
PORT=8000

# Database - SQLite for the MVP; replace with a PostgreSQL URL later.
DATABASE_URL="sqlite:///./storage/ai_agent_builder.db"

# File storage and RAG
DOCUMENT_STORAGE_PATH="storage/documents"
CHROMA_PERSIST_DIRECTORY="storage/chroma_db"
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_DOCUMENT_EXTENSIONS=".pdf,.txt,.md,.markdown,.docx"
CHUNK_SIZE_CHARACTERS=1000
CHUNK_OVERLAP_CHARACTERS=150
EMBEDDING_BATCH_SIZE=100

# LLM and embeddings - set real values only in .env, never in source control.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
LLM_PROVIDER="openai"
EMBEDDING_PROVIDER="openai"
LLM_MODEL="gpt-5-mini"
EMBEDDING_MODEL="text-embedding-3-small"

# First administrator bootstrap. Set all three before first production startup.
INITIAL_ADMIN_USERNAME=""
INITIAL_ADMIN_EMAIL=""
INITIAL_ADMIN_PASSWORD=""
PASSWORD_HASH_ROUNDS=12

# Session and login protection. Use a long random value in production.
SESSION_SECRET_KEY=""
SESSION_COOKIE_NAME="ai_agent_builder_session"
LOGIN_MAX_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_SECONDS=900
LOGIN_LOCKOUT_SECONDS=900
